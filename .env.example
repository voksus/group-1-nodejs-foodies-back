NODE_ENV=development
PORT=3000

# Local PostgreSQL: docker compose up -d --wait postgres
# Keep this port aligned with DATABASE_URL if you change it.
POSTGRES_PORT=55432
DATABASE_URL="postgresql://foodies_user:foodies_password@localhost:55432/foodies_db"

# Optional for local development: Prisma CLI and seed fall back to DATABASE_URL.
# DIRECT_URL="postgresql://foodies_user:foodies_password@localhost:55432/foodies_db"

# Shared Neon dev environment (replace DATABASE_URL and set DIRECT_URL there):
# DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require"
# Neon pooled hostname contains -pooler; the direct hostname does not.

# JWT & Cookies
JWT_SECRET="replace-with-strong-secret-at-least-32-chars"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=7

# CORS (comma-separated allowed origins)
ALLOWED_ORIGINS="http://localhost:5173"

# Cloudinary (required for user avatars and recipe images)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
