NODE_ENV=development
PORT=3000

# Neon pooled connection for normal application queries
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/neondb?sslmode=require"

# Neon direct connection for Prisma Migrate and seed (optional for local Docker)
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require"

# JWT & Cookies
JWT_SECRET="replace-with-strong-secret-at-least-32-chars"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=7

# CORS (comma-separated allowed origins)
ALLOWED_ORIGINS="http://localhost:5173"

# Cloudinary (required for user avatars and recipe images)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret